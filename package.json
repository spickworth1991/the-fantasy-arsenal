{
  "name": "the-fantasy-arsenal",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "update:stats": "node --no-warnings ./scripts/updateHistoricalStats.js && node --no-warnings ./scripts/updateAdvancedStats.js && node --no-warnings ./scripts/buildStatInsights.js",
    "dev": "next dev",
    "build": "node --no-warnings ./scripts/checkPublicAssetSizes.js && next build",
    "start": "next start",
    "lint": "next lint",
    "build:cf": "next-on-pages",
    "preview:cf": "next-on-pages",
    "postinstall": "npx next telemetry disable || true",
    "update": "node ./scripts/updateValues.js",
    "update:daily": "node --no-warnings ./scripts/updateSleeperResearch.js && node --no-warnings ./scripts/updateValues.js --daily --defer-archive && node --no-warnings ./scripts/updateHistoricalStats.js --sleeper-only && node --no-warnings ./scripts/updateAdvancedStats.js --current && node --no-warnings ./scripts/buildStatInsights.js && node --no-warnings ./scripts/buildStatProjectionModel.js --archive && node --no-warnings ./scripts/updateValues.js --only=arsenal_proj --archive && node --no-warnings ./scripts/auditProjectionPipeline.js && node --no-warnings ./scripts/evaluateStatProjectionModel.js && node --no-warnings ./scripts/evaluateProjectionChallenger.js --challenger=team-volume-v1 && node --no-warnings ./scripts/evaluatePropLab.js",
    "update:sleeper-research": "node --no-warnings ./scripts/updateSleeperResearch.js",
    "update:stat-model": "node --no-warnings ./scripts/updateValues.js --only=projection_anchor && node --no-warnings ./scripts/buildStatProjectionModel.js --archive && node --no-warnings ./scripts/updateValues.js --only=arsenal_proj --archive && node --no-warnings ./scripts/auditProjectionPipeline.js && node --no-warnings ./scripts/evaluateStatProjectionModel.js",
    "audit:stat-model": "node --no-warnings ./scripts/auditProjectionPipeline.js",
    "bets:update": "node --no-warnings ./scripts/updatePropLab.js --mode=auto",
    "bets:update:auto": "node --no-warnings ./scripts/updatePropLab.js --mode=auto",
    "bets:update:manual": "node --no-warnings ./scripts/updatePropLab.js --mode=manual",
    "bets:list": "node --no-warnings ./scripts/fetchSportsGameOddsSnapshot.js --list",
    "bets:evaluate": "node --no-warnings ./scripts/evaluatePropLab.js",
    "capture:pre-kickoff": "node --no-warnings ./scripts/capturePreKickoffSnapshot.js",
    "update:advanced": "node --no-warnings ./scripts/updateAdvancedStats.js",
    "evaluate:stat-model": "node --no-warnings ./scripts/evaluateStatProjectionModel.js",
    "model:challenger:train": "node --no-warnings ./scripts/backtest-stat-model.mjs --candidate=current",
    "model:challenger:capture": "node --no-warnings ./scripts/buildStatProjectionModel.js --challenger=team-volume-v1 --shadow-definition=data/model-challengers/team-volume-v1/definition.json",
    "model:challenger:evaluate": "node --no-warnings ./scripts/evaluateProjectionChallenger.js --challenger=team-volume-v1",
    "model:challenger:promote": "node --no-warnings ./scripts/promoteProjectionChallenger.js --challenger=team-volume-v1",
    "model:backtest:audit": "node --no-warnings ./scripts/backtest-stat-model.mjs --seasons=2023,2024,2025 --skip-saved-sources --output-dir=scripts/_stat_backtests/audits --output-name=latest-audit",
    "model:replay": "node --no-warnings ./scripts/replayStatProjectionModel.mjs",
    "model:replay:test": "node --no-warnings ./scripts/testProjectionReplay.mjs",
    "model:shadow:test": "node --no-warnings ./scripts/testProjectionShadowArms.mjs",
    "build:stat-insights": "node --no-warnings ./scripts/buildStatInsights.js",
    "update:ballsville-stats": "node --no-warnings ./scripts/updateBallsvilleStats.js && node --no-warnings ./scripts/buildPlayerStockDrafters.js",
    "build:player-stock-drafters": "node --no-warnings ./scripts/buildPlayerStockDrafters.js",
    "archive:values": "node ./scripts/updateValues.js --archive-only",
    "update2": "node scripts/updateValues --show-browser --devtools --slowmo=200 --shots --keep-open",
    "stick": "node ./scripts/sp-editor.js",
    "fetch": "node scripts/fetch.mjs --format=webp --quality=70 --force",
    "git": "git add . && git commit -m \"DraftCommand_SearchLeague\" && git push origin main",
    "sync": "node ./scripts/git-sync.mjs \"projection_Update\""
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.1",
    "axios": "^1.11.0",
    "express": "^5.2.1",
    "idb-keyval": "^6.2.2",
    "next": "14.2.13",
    "papaparse": "^5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.1.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.14",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "vercel": "46.0.2"
  },
  "optionalDependencies": {
    "inquirer": "^12.9.0",
    "puppeteer": "^24.15.0"
  }
}
